SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_AUTH_MODE=demo
SENTINEL_JWT_ISSUER=http://localhost:8080/realms/mcp-sentinel
SENTINEL_JWT_AUDIENCE=mcp-sentinel
SENTINEL_JWT_ALGORITHMS=RS256,HS256
SENTINEL_DEMO_JWT_SECRET=change-me-demo-only-not-for-production
SENTINEL_OIDC_JWKS_URL=http://localhost:8080/realms/mcp-sentinel/protocol/openid-connect/certs
SENTINEL_OIDC_INTROSPECT_URL=http://localhost:8080/realms/mcp-sentinel/protocol/openid-connect/token/introspect
SENTINEL_OIDC_CLIENT_ID=mcp-sentinel
SENTINEL_OIDC_CLIENT_SECRET=sentinel-client-secret
SENTINEL_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_OPA_URL=http://localhost:8181
SENTINEL_OPA_ENABLED=false
SENTINEL_GATEWAY_HOST=0.0.0.0
SENTINEL_GATEWAY_PORT=8443
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SENTINEL_TLS_ENABLED=false
SENTINEL_LEASE_DEFAULT_SECONDS=120
SENTINEL_WORKFLOW_TTL_SECONDS=1800
SENTINEL_MFA_ACR=http://schemas.openid.net/pape/policies/2007/06/multi-factor
SENTINEL_HARD_BLOCK_ON_QUARANTINE=true
SENTINEL_MAX_RISK_ALLOW=39
SENTINEL_MFA_RISK_THRESHOLD=60
SENTINEL_BLOCK_RISK_THRESHOLD=80
SENTINEL_SANDBOX_ENABLED=false
SENTINEL_SANDBOX_IMAGE=mcp-sentinel-sandbox:dev
SENTINEL_PUBLIC_REGISTRY_URL=
SENTINEL_PUBLIC_REGISTRY_OVERRIDE_LOCAL=true
